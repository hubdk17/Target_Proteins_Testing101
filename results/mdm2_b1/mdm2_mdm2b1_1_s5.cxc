# mdm2_mdm2b1_1_s5 - open this file from the folder that holds the .pdb
open mdm2_mdm2b1_1_s5_af2pred.pdb
hide atoms
show cartoon
color /A cornflower blue
color /B light gray
# aimed p53-cleft hotspots (MDM2 61,62,67,93,99 -> these renumbered ids)
show /B:88,89,94,120,126 atoms
style /B:88,89,94,120,126 stick
color /B:88,89,94,120,126 orange
# the real interface, computed geometrically (cannot be mis-numbered)
select /A & /B :<5
show sel atoms
style sel stick
color sel gold
select clear
view
