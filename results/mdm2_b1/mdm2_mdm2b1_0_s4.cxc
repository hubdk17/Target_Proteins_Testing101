# mdm2_mdm2b1_0_s4 - open this file from the folder that holds the .pdb
open mdm2_mdm2b1_0_s4_af2pred.pdb
hide atoms
show cartoon
color /A cornflower blue
color /B light gray
# aimed p53-cleft hotspots (MDM2 61,62,67,93,99 -> these renumbered ids)
show /B:78,79,84,110,116 atoms
style /B:78,79,84,110,116 stick
color /B:78,79,84,110,116 orange
# the real interface, computed geometrically (cannot be mis-numbered)
select /A & /B :<5
show sel atoms
style sel stick
color sel gold
select clear
view
