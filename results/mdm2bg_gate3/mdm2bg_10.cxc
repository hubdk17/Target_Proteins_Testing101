# mdm2bg_10 - open this file from the folder that holds the .pdb
open mdm2bg_10_af2pred.pdb
hide atoms
show cartoon
color /A cornflower blue
color /B light gray
# aimed p53-cleft hotspots (MDM2 61,62,67,93,99 -> these renumbered ids)
show /B:106,107,112,138,144 atoms
style /B:106,107,112,138,144 stick
color /B:106,107,112,138,144 orange
# the real interface, computed geometrically (cannot be mis-numbered)
select /A & /B :<5
show sel atoms
style sel stick
color sel gold
select clear
view
