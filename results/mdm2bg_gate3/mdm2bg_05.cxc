# mdm2bg_05 - open this file from the folder that holds the .pdb
open mdm2bg_05_af2pred.pdb
hide atoms
show cartoon
color /A cornflower blue
color /B light gray
# aimed p53-cleft hotspots (MDM2 61,62,67,93,99 -> these renumbered ids)
show /B:109,110,115,141,147 atoms
style /B:109,110,115,141,147 stick
color /B:109,110,115,141,147 orange
# the real interface, computed geometrically (cannot be mis-numbered)
select /A & /B :<5
show sel atoms
style sel stick
color sel gold
select clear
view
